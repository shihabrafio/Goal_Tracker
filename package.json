{
  "name": "goalpay-tracker",
  "version": "1.0.0",
  "description": "Savings goals, work hours needed and expense tracking",
  "main": "electron/main.js",
  "author": "You",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.goalpay.tracker",
    "productName": "GoalPay Tracker",
    "files": ["electron/**", "www/**"],
    "win": { "target": "portable" },
    "directories": { "output": "dist" }
  }
}
